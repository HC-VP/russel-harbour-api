<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Tableau de bord</title>
</head>
<body>

  <h1>Tableau de bord</h1>

  <p>
    <a href="/catways">Liste des catways</a> |
    <a href="/reservations">Liste des réservations</a> |
    <a href="/documentation">Documentation API</a>
  </p>

  <hr>

  <h2>Utilisateurs</h2>

  <h3>Créer un utilisateur</h3>
  <form method="POST" action="/dashboard/users/create">
    <input type="text" name="name" placeholder="Nom" required>
    <input type="email" name="email" placeholder="Email" required>
    <input type="password" name="password" placeholder="Mot de passe" required>
    <button type="submit">Créer</button>
  </form>

  <h3>Modifier un utilisateur</h3>
  <form method="POST" action="/dashboard/users/update">
    <input type="text" name="id" placeholder="ID utilisateur" required>
    <input type="text" name="name" placeholder="Nouveau nom">
    <input type="email" name="email" placeholder="Nouvel email">
    <button type="submit">Modifier</button>
  </form>

  <h3>Supprimer un utilisateur</h3>
  <form method="POST" action="/dashboard/users/delete">
    <input type="text" name="id" placeholder="ID utilisateur" required>
    <button type="submit">Supprimer</button>
  </form>

  <hr>

  <h2>Catways</h2>

  <h3>Créer un catway</h3>
  <form method="POST" action="/dashboard/catways/create">
    <input type="number" name="catwayNumber" placeholder="Numéro" required>
    <select name="type" required>
      <option value="long">Long</option>
      <option value="short">Short</option>
    </select>
    <input type="text" name="catwayState" placeholder="État" required>
    <button type="submit">Créer</button>
  </form>

  <h3>Modifier l’état d’un catway</h3>
  <form method="POST" action="/dashboard/catways/update-state">
    <input type="number" name="id" placeholder="Numéro catway" required>
    <input type="text" name="catwayState" placeholder="Nouvel état" required>
    <button type="submit">Modifier</button>
  </form>

  <h3>Supprimer un catway</h3>
  <form method="POST" action="/dashboard/catways/delete">
    <input type="number" name="id" placeholder="Numéro catway" required>
    <button type="submit">Supprimer</button>
  </form>

  <h3>Afficher les détails d’un catway</h3>
  <form method="GET" action="/catway">
    <input type="number" name="id" placeholder="Numéro catway" required>
    <button type="submit">Afficher</button>
  </form>

  <hr>

  <h2>Réservations</h2>

  <h3>Enregistrer une réservation</h3>
  <form method="POST" action="/dashboard/reservations/create">
    <input type="number" name="catwayNumber" placeholder="Numéro catway" required>
    <input type="text" name="clientName" placeholder="Nom client" required>
    <input type="text" name="boatName" placeholder="Nom bateau" required>
    <input type="date" name="checkIn" required>
    <input type="date" name="checkOut" required>
    <button type="submit">Réserver</button>
  </form>

  <h3>Supprimer une réservation</h3>
  <form method="POST" action="/dashboard/reservations/delete">
    <input type="text" name="idReservation" placeholder="ID réservation" required>
    <button type="submit">Supprimer</button>
  </form>

  <h3>Afficher les détails d’une réservation</h3>
  <form method="GET" action="/reservation">
    <input type="text" name="id" placeholder="ID réservation" required>
    <button type="submit">Afficher</button>
  </form>

</body>
</html>